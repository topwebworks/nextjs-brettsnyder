# Brett Snyder Portfolio
# Copy this file to .env.local and replace the example values.

# Public contact and profile links
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/example
NEXT_PUBLIC_GITHUB_URL=https://github.com/example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resume download
NEXT_PUBLIC_RESUME_PATH=/resume-brett-snyder.pdf
NEXT_PUBLIC_SHOW_RESUME=true

# Optional analytics and consent integrations
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_TERMLY_UUID=
